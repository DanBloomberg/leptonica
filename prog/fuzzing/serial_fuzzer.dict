# Leptonica structured-object serialiser tokens for serial_fuzzer.
# Header keywords of the BOXA/BOXAA/NUMA/NUMAA/PTA/PIXA/PIXAA/PIXCMAP
# ASCII serialisations, plus the PNG magic (PIXA/PIXAA embed PNG streams).
"Boxa Version 2"
"Number of boxes = "
"Box[0]: x = "
"Boxaa Version 3"
"Number of boxa = "
"Boxa[0] extent: x = "
"Numa Version 1"
"Number of numbers = "
"startx = 0.000000, delx = 1.000000"
"Numaa Version 1"
"Number of numa = "
"Numa[0]:"
" Pta Version 1"
" Number of pts = 1; format = float"
" Number of pts = 1; format = integer"
"   (1.000000, 2.000000)"
"Pixa Version 2"
"Number of pix = "
" pix[0]: xres = 300, yres = 300"
"Pixaa Version 2"
"Number of pixa = "
" --------------- pixa[0] ---------------"
"Pixcmap: depth = 8 bpp; 3 colors"
"Color    R-val    G-val    B-val   Alpha"
"\x89PNG\x0d\x0a\x1a\x0a"
"IHDR"
"IDAT"
"IEND"
"spix"
