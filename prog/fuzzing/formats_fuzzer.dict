# Leptonica image file-format tokens for formats_fuzzer.
# Magic bytes and header keywords of every format compiled into the fuzz build
# (bmp, jpeg, png, pnm/pam, tiff, webp, spix; plus write-only pdf/ps).
"P1"
"P2"
"P3"
"P4"
"P5"
"P6"
"P7"
"BM"
"\x89PNG\x0d\x0a\x1a\x0a"
"IHDR"
"IDAT"
"IEND"
"PLTE"
"\xff\xd8"
"\xff\xd9"
"JFIF"
"II*\x00"
"MM\x00*"
"RIFF"
"WEBP"
"VP8 "
"VP8L"
"VP8X"
"spix"
"%PDF-"
"%%EOF"
"%!PS-Adobe"
"WIDTH"
"HEIGHT"
"DEPTH"
"MAXVAL"
"TUPLTYPE"
"ENDHDR"
